<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>flever 花艺定制</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="phone active" id="p-home">

  <nav class="rise">
    <div class="nav-brand">flever 花艺定制</div>
    <button class="nav-me" onclick="location='/orders'">我</button>
  </nav>

  <div class="hero rise d1">
    <div class="eyebrow">FLORA ATELIER · 花艺定制</div>
    <h1>定制一束，<br>只属于你的花。</h1>
    <p class="sub">花艺师已完成构思，<br>你只负责选择心意。</p>
  </div>

  <div class="hero-figure rise d2">
    <div class="work-hero">作 品 图 1 : 1</div>
  </div>

  <section class="reveal">
    <div class="sec-head">
      <div class="en">GALLERY</div>
      <h2>往期作品。</h2>
    </div>
    <div class="strip">
      <div class="shot-wrap"><div class="shot s1"></div><div class="shot-cap">「山茶与雾」</div><div class="shot-sub">客定 · 8 月</div></div>
      <div class="shot-wrap"><div class="shot s2"></div><div class="shot-cap">「白露」</div><div class="shot-sub">客定 · 8 月</div></div>
      <div class="shot-wrap"><div class="shot s3"></div><div class="shot-cap">「暮金」</div><div class="shot-sub">高定 · 7 月</div></div>
      <div class="shot-wrap"><div class="shot s4"></div><div class="shot-cap">「拾夏」</div><div class="shot-sub">客定 · 7 月</div></div>
    </div>
  </section>

  <section class="reveal">
    <div class="sec-head">
      <div class="en">SIGNATURE CONCEPTS</div>
      <h2>花艺师的选题。</h2>
      <div class="hint">还停在笔记本上的三个构思 · 点一张选定</div>
    </div>
    <div class="paper">
      <% ['「山茶与雾」|静|克制的美，不需要喧哗|以山茶的沉稳为骨，雾灰色的桔梗作烟。适合安静、内敛的表达。',
          '「夏日尽头」|烈|把季节留住给一个人|向日葵与狗尾草的野趣混搭，浓烈又松弛，像夏天最后一场傍晚。',
          '「月白」|素|留白即言语|白绿为主，枝叶留出大量呼吸感。叶是主角，花只是月光落下的位置。'].forEach((n, i) => {
           const [name, phil, idea, desc] = n.split('|'); %>
      <div class="note <%= i === 0 ? 'sel' : '' %>" data-name="<%= name %>" data-phil="<%= phil %>" data-idea="<%= idea %>">
        <h3><%= name %></h3>
        <div class="desc"><%= desc %></div>
        <div class="phil">主题 —— <b><%= phil %></b> ｜ <%= idea %></div>
      </div>
      <% }); %>
    </div>
    <div class="paper-hint">—— 花艺师的工作笔记 · 左右滑动 · 点一张定为你的花 ——</div>
  </section>

  <section class="reveal">
    <div class="sec-head">
      <div class="en">COLLECTION</div>
      <h2>选择档位。</h2>
      <div class="hint">档位差异 = 价格 + 花材规格（3 档名称价格待商家提供）</div>
    </div>
    <div class="tiers" id="homeTiers">
      <% tiers.forEach((t, i) => { %>
      <div class="tier <%= i === 0 ? 'sel' : '' %>" data-name="<%= t.name %>" data-price="<%= t.price / 100 %>">
        <% if (t.tag) { %><span class="tier-tag"><%= t.tag %></span><% } %>
        <div class="tier-name"><%= t.name %></div>
        <div class="tier-desc"><%= t.desc %></div>
        <div class="tier-bottom"><span class="tier-price"><%= t.price / 100 %></span><span class="tier-link">选择 ›</span></div>
      </div>
      <% }); %>
    </div>
  </section>

  <div class="cta-wrap reveal">
    <button class="btn-cta" onclick="goOrder()">预 定</button>
    <div class="queue-line">今日还剩 <b><%= remaining %></b> 个名额 · 最早可排 <%= earliest %></div>
  </div>

  <section class="reveal" style="margin-top:44px">
    <div class="sec-head">
      <div class="en">SCHEDULE</div>
      <h2>近期制作排期。</h2>
    </div>
    <div class="gantt-card">
      <div class="g-days"><span>周一</span><span>周二</span><span>周三</span><span>周四</span><span>周五</span><span>周六</span><span>周日</span></div>
      <div class="g-row"><div class="g-label">进行中</div><div class="g-track"><div class="g-bar" style="left:0;width:42%">本周订单</div></div></div>
      <div class="g-row"><div class="g-label">新订单</div><div class="g-track"><div class="g-bar mine" style="left:50%;width:32%">你 · 制作排期见成功页</div></div></div>
      <div class="g-row"><div class="g-label">交付</div><div class="g-track"><div class="g-bar mine" style="left:84%;width:15%">交付</div></div></div>
      <div class="gantt-note"><b>这张排期表实时更新。</b>每一件作品都按下单顺序手工制作、不赶工——你可以看到自己的花大约哪天开始做、哪天到你手上。「慢」，是我们对品质的承诺。</div>
    </div>
  </section>

</div>
<script>
const state = { topic: document.querySelector('.note.sel')?.dataset.name || '「山茶与雾」', tier: '' };
document.querySelectorAll('.note').forEach(n => n.addEventListener('click', () => {
  document.querySelectorAll('.note').forEach(x => x.classList.remove('sel'));
  n.classList.add('sel'); state.topic = n.dataset.name;
}));
document.getElementById('homeTiers').addEventListener('click', e => {
  const t = e.target.closest('.tier'); if (!t) return;
  document.querySelectorAll('#homeTiers .tier').forEach(x => x.classList.remove('sel'));
  t.classList.add('sel'); state.tier = t.dataset.name;
});
function goOrder() {
  location = '/order/new?topic=' + encodeURIComponent(state.topic) + '&tier=' + encodeURIComponent(state.tier);
}
const io = new IntersectionObserver(es => es.forEach(e => {
  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
}), { threshold: .12, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>flora 管理后台</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="admin" style="max-width:420px;padding-top:12vh">
  <h1>flora 管理后台</h1>
  <div class="sub">密码登录 · 密码由环境变量 ADMIN_PASSWORD 配置</div>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <div class="admin-card">
    <form method="post" action="/admin/login">
      <div class="field">
        <label style="display:block;font-size:12px;color:var(--gray);margin-bottom:8px">密码</label>
        <input type="password" name="password" style="width:100%" autofocus>
      </div>
      <button class="btn-sm" style="width:100%;padding:12px;font-size:14px">登录</button>
    </form>
  </div>
</div>
</body>
</html>
